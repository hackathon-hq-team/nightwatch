# Copy to .env and configure values. Never commit .env.
# Add variables as the stack evolves.

PORT=3000
# DATABASE_URL=
# API_KEY=

# --- Nightwatch agent ---
# Nebius Token Factory: console → API keys → Create API key
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Check the exact id: python -m nightwatch.cli models
NIGHTWATCH_MODEL=nvidia/nemotron-3-super-120b-a12b
# Stronger model for retries after failures; leave empty to disable escalation
NIGHTWATCH_ESCALATION_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Optional cheap first look before the investigation; leave empty to skip triage
NIGHTWATCH_TRIAGE_MODEL=
NIGHTWATCH_HISTORY=history
NIGHTWATCH_INCIDENT_BUDGET=0.50
NIGHTWATCH_DAILY_BUDGET=5.00
# Code root inside the app container (for Sentry file paths)
NIGHTWATCH_CODE_ROOT=
