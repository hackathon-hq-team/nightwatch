# Скопируйте в .env и заполните значения. Сам .env не коммитим.
# Переменные добавляем по мере появления стека.

PORT=3000
# DATABASE_URL=
# API_KEY=

# --- Nightwatch: агент (Никита) ---
# Nebius Token Factory: консоль → API keys → Create API key
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Точный ID проверить: python -m nightwatch.cli models
NIGHTWATCH_MODEL=nvidia/nemotron-3-super-120b-a12b
NIGHTWATCH_HISTORY=history
NIGHTWATCH_INCIDENT_BUDGET=0.50
NIGHTWATCH_DAILY_BUDGET=5.00
# Корень кода внутри контейнера приложения (для путей из Sentry)
NIGHTWATCH_CODE_ROOT=
